{
  // AMBIENTE DE VALIDAÇÃO — PAINEL (proposta D-053, revisão independente 04/11, item 4).
  // Par do coletor de validação (wrangler.validation.jsonc): mesmo D1 isolado semed-auth-validacao, nunca o oficial.
  // Fotos: sem provedor configurado, o recebimento fica desabilitado (photosEnabled:false). Para testar fotos em validação,
  // definir PHOTO_STORAGE_PROVIDER=r2 e um bucket R2 exclusivo de validação (binding PHOTOS) criado pelo responsável técnico;
  // NUNCA reutilizar tokens/segredos do Drive institucional nem o bucket de produção neste ambiente.
  // Este Worker ainda não existe na conta: a primeira publicação depende de aprovação explícita (MIGRACOES_E_PUBLICACAO.txt §3).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-semed-paco-validacao-painel",
  "account_id": "ce059c2b3e50037922a441a66814090d",
  "compatibility_date": "2026-10-27",
  "main": "server/worker.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "DEBUG_COLLECTION": "1" },
  "assets": { "directory": "./dist/painel", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "404-page" },
  "d1_databases": [ { "binding": "DB", "database_name": "semed-auth-validacao", "database_id": "90a217c8-8540-4ee2-a2a4-8e328137c5a1", "migrations_dir": "migrations" } ],
  // Manutenção diária do módulo de agentes também em validação (um único Worker por banco).
  "triggers": { "crons": ["41 3 * * *"] }
}
